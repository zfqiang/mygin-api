APP_MODE=debug
APP_PORT=8080

# Replace this value before deploying; the secret must be at least 32 bytes.
JWT_SECRET=dev-only-change-this-secret-before-use-123456789
JWT_ISSUER=mygin-api
JWT_TTL=24h

# CORS
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_HEADERS=Origin, Content-Type, Accept, Authorization
CORS_ALLOW_METHODS=GET, POST, PUT, DELETE, OPTIONS
CORS_ALLOW_CREDENTIALS=true

# Rate Limit    # https://github.com/ulule/limiter
RATE_LIMIT=20
RATE_BURST=50
RATE_LIMIT_IP=2
RATE_BURST_IP=5

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# WorkPool
WORK_POOL_SIZE=20
WORK_POOL_IDLE_TIMEOUT=60s
 
# Database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mygin_api

# Redis
REDIS_ADDR=127.0.0.1
REDIS_PASSWORD=
REDIS_DB=0
